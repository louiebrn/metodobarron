# Copy to .env.local if you want to override the defaults.
# `npm run dev` runs in demo mode with no Stripe secrets.

# SQLite file. Created on first use. Do not commit it.
DATABASE_PATH=./data/members.db

# Public URL of this app (Stripe Customer Portal return link).
APP_URL=http://localhost:3000

# Marketing site linked from the logo.
MARKETING_URL=https://metodobarron.com

# Demo mode unlocks a local "assinatura de demonstração" toggle and accepts
# webhook JSON signed only with DEMO_WEBHOOK_TOKEN.
# Unset: ON during `next dev` when STRIPE_WEBHOOK_SECRET is empty; OFF when NODE_ENV=production.
DEMO_MODE=
DEMO_WEBHOOK_TOKEN=demo-local

# Live Payment Link (public — already on the marketing site). Not a secret.
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/cNi6oG8sBewcaWk7tldfG01
STRIPE_PAYMENT_LINK_ID=plink_1UYTL9COW8xQ7IOjQ0gliHvp

# Leave empty until you wire the live account. Never commit the secret key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional static Customer Portal login link from the Stripe Dashboard
# (used when STRIPE_SECRET_KEY is not set).
STRIPE_CUSTOMER_PORTAL_LOGIN_URL=
